              ]
            },
            "internal": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "position": {
                        "type": "integer"
                      },
                      "modifications": {
                        "anyOf": [
                          {
                            "type": "object",
                            "additionalProperties": {
                              "type": "integer"
                            }
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "position",
                      "modifications"
                    ],
                    "additionalProperties": false
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "isotope",
            "fixed",
            "labile",
            "unlocalized",
            "n_terminal",
            "c_terminal",
            "internal"
          ],
          "additionalProperties": false
        },
        "intervals": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer"
