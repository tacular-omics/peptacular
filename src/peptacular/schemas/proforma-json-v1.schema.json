    },
    {
      "$ref": "#/$defs/TagCustom"
    },
    {
      "$ref": "#/$defs/GlycanComponent"
    },
    {
      "$ref": "#/$defs/GlycanTag"
    },
    {
      "$ref": "#/$defs/PositionTag"
    },
    {
      "$ref": "#/$defs/LimitTag"
